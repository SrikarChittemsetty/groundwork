// Values-Mirror data model.
//
// Design note: every field that holds a user's actual values/beliefs/decisions
// (title, body, reflection text) is stored ENCRYPTED at the application layer
// via src/lib/crypto.ts (AES-256-GCM). The database only ever sees ciphertext,
// so a DB dump alone does not expose anyone's beliefs. See DESIGN principle
// "Sensitive data by default."
//
// Dev uses SQLite for zero-setup local runs. To move to Postgres (per the build
// plan), change `provider` to "postgresql" and point DATABASE_URL at your
// Postgres instance — no model changes required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  values        Value[]
  decisions     Decision[]
  reflections   Reflection[]
  consultations Consultation[]
  positions     Position[]
  axioms        Axiom[]
  axiomVersions AxiomVersion[]
  tensions      AxiomTension[]
  resets        PasswordReset[]
  ownedCircles  Circle[]        @relation("CircleOwner")
  memberships   CircleMember[]
  circleReads   CircleRead[]
  shares        Share[]
  shareComments ShareComment[]
}

// Failed sign-in attempts, used to throttle brute-force guessing.
//
// Keyed by (email, ip) rather than email alone. Throttling on email alone would
// hand an attacker a denial-of-service: burn ten wrong guesses and the real
// owner is locked out too. Scoping to the source address means an abusive
// client throttles only itself. Cleared on a successful sign-in.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String   @default("unknown")
  createdAt DateTime @default(now())

  @@index([email, ip, createdAt])
}

// A password reset in flight.
//
// Only the SHA-256 of the token is stored. A reset table full of usable
// tokens is a second password database, and this one would hand over an
// account holding somebody's beliefs. The plaintext exists in the link and
// nowhere else.
//
// Resets are safe here because entries are encrypted with an application key,
// not one derived from the password — changing a password loses nothing.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A stated core value/belief. `title` and `body` are ciphertext and always hold
// the CURRENT wording; every wording this value has ever had is kept in
// ValueVersion so the user can see how their own values shifted over time.
model Value {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  versions  ValueVersion[]
  decisions DecisionValue[]

  @@index([userId])
}

// Append-only history of a value's wording. One row is written when the value
// is first stated and one on every subsequent edit, so "what I believed then"
// is never overwritten by "what I believe now" — drift over time is the point
// of the product, not an accident to be discarded.
model ValueVersion {
  id        String   @id @default(cuid())
  valueId   String
  value     Value    @relation(fields: [valueId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([valueId])
  @@index([userId])
}

// A real decision/action the user took, with the time it happened. `body` is ciphertext.
model Decision {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  occurredAt DateTime
  createdAt  DateTime        @default(now())
  values     DecisionValue[]

  @@index([userId])
}

// Which stated values a decision bears on, as judged by the user themselves.
// This is deliberately user-declared rather than AI-inferred: the person is the
// authority on what their own decision was about. It makes alignment and
// tension concrete instead of guessed at.
model DecisionValue {
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  valueId    String
  value      Value    @relation(fields: [valueId], references: [id], onDelete: Cascade)
  userId     String

  @@id([decisionId, valueId])
  @@index([valueId])
  @@index([userId])
}

// --- Positions, why-chains, axioms -----------------------------------------
//
// The interrogation. You state a position; the tool asks why; you answer; it
// asks why again. It stops when you say there is nothing underneath — and
// that terminus is an axiom.
//
// No model is involved. "Why?" is a question a text file can ask, and the
// answers have to be yours or the exercise is pointless. What the tool
// contributes is refusing to let you stop early, and remembering where you
// landed last time.

model Position {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The claim being interrogated, e.g. "I should turn down this offer".
  statement  String
  createdAt  DateTime     @default(now())
  // Set when you decide you've reached the bottom of every branch.
  settledAt  DateTime?
  nodes      ReasonNode[]

  @@index([userId])
}

// One link in a chain of reasons: the answer to "why?" asked of its parent.
// A node with no parent answers the position itself.
model ReasonNode {
  id         String       @id @default(cuid())
  positionId String
  position   Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  userId     String
  parentId   String?
  parent     ReasonNode?  @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   ReasonNode[] @relation("NodeChildren")
  claim      String
  // Bedrock: you were asked why and had nothing further. The honest end of a
  // chain, not a failure to think harder.
  isBedrock  Boolean      @default(false)
  // Which accumulated axiom this bedrock turned out to be, when you recognise
  // it as one you've already hit.
  axiomId    String?
  axiom      Axiom?       @relation(fields: [axiomId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([positionId])
  @@index([parentId])
  @@index([axiomId])
}

// Something you hold with no reason underneath it.
//
// Axioms accumulate across positions on purpose: the discovery that ten
// different arguments all bottom out in the same three commitments is the
// most useful thing this tool can show you.
// Changing one is the point at which this stops being a journal. If a position
// rests on an axiom and the axiom moves, whatever was derived from it is no
// longer derived — it's just a conclusion you happen to still be holding.
// `revisedAt` and `retiredAt` are what everything downstream is compared
// against, so the consequence is computed rather than remembered.
//
// Retiring is deliberately not deleting. "I no longer hold this" is a fact
// about you worth keeping, and the positions that were built on it need to
// still show what they were built on.
model Axiom {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement  String
  createdAt  DateTime     @default(now())
  revisedAt  DateTime?
  retiredAt  DateTime?
  nodes      ReasonNode[]
  versions   AxiomVersion[]
  tensionsA  AxiomTension[] @relation("TensionA")
  tensionsB  AxiomTension[] @relation("TensionB")

  @@index([userId])
}

// What an axiom used to say. Same reasoning as ValueVersion: rewording what
// you hold as bedrock is exactly the change you'd most want to be able to look
// back at, and an edit that overwrites it destroys the only evidence that you
// moved.
model AxiomVersion {
  id        String   @id @default(cuid())
  axiomId   String
  axiom     Axiom    @relation(fields: [axiomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  statement String
  createdAt DateTime @default(now())

  @@index([axiomId])
  @@index([userId])
}

// Two of your axioms that pull against each other.
//
// Deliberately something YOU assert, never something the tool detects. Two
// commitments in tension is not a defect to be flagged and repaired — at the
// level where axioms live, most people are internally consistent and simply
// hold different things as bedrock. A tool that announced "these contradict"
// would be handing down exactly the verdict this whole thing refuses to make.
//
// It also isn't a task list. `resolvedAt` records that you came to a view, and
// "I hold both and accept the cost" is as legitimate a resolution as dropping
// one. An unresolved tension you've simply looked at squarely is fine.
model AxiomTension {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stored with aId < bId so a pair can't be recorded twice in two orders.
  aId        String
  a          Axiom     @relation("TensionA", fields: [aId], references: [id], onDelete: Cascade)
  bId        String
  b          Axiom     @relation("TensionB", fields: [bId], references: [id], onDelete: Cascade)
  note       String
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([aId, bId])
  @@index([userId])
}

// --- Sharing ---------------------------------------------------------------
//
// The private record stays private. Sharing hands over a SNAPSHOT of one
// specific thing you chose, at the moment you chose it — never a live window
// into your journal, and never anything you didn't pick. Every field the
// recipient sees is one the sharer opted into, and anything shared can be
// hidden or revoked later without being deleted.
//
// Snapshots rather than references, deliberately: what you showed someone
// should stay what you showed them, even after you rewrite the original.

model Circle {
  id        String         @id @default(cuid())
  name      String
  ownerId   String
  // Deleting your account deletes rooms you created. There is no owner left
  // to manage them, and the alternative — an ownerless room still holding
  // your shared writing — is exactly what "delete everything" must not mean.
  owner     User           @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  members   CircleMember[]
  invites   CircleInvite[]
  shares    Share[]
  reads     CircleRead[]

  @@index([ownerId])
}

model CircleMember {
  id       String   @id @default(cuid())
  circleId String
  circle   Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([circleId, userId])
  @@index([userId])
}

// Invites come in two strengths, because "text this to Sarah" and "post this
// where several people will see it" are different acts.
//
//   - No `email`: a bearer link. Whoever holds it can join, and it keeps
//     working until it expires or is revoked.
//   - With `email`: bound to one person and single-use. Only an account with
//     that address can accept it, and accepting burns it — forwarding the
//     link to someone else gets them nothing.
//
// Either way it is revocable and can expire: handing someone a link is not
// the same as trusting them indefinitely.
// The token itself is never stored in the clear. `tokenHash` is a plain
// SHA-256 of it — deterministic, so a link can still be looked up — and
// `tokenEnc` is the same token encrypted with the app key so the owner can
// re-read a link they created. A stolen database file therefore yields no
// usable invite: the hash can't be reversed and the ciphertext needs a key
// that isn't in the file. That is the same bargain as everything else here.
model CircleInvite {
  id          String    @id @default(cuid())
  circleId    String
  circle      Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  tokenEnc    String
  createdById String
  email       String?
  claimedById String?
  claimedAt   DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([circleId])
}

// Where each person had last read a circle, so "someone replied and you never
// found out" stops being the default. Deliberately just a timestamp — no read
// receipts shown to others, no pressure to respond, nothing that turns a
// conversation into an obligation.
model CircleRead {
  id         String   @id @default(cuid())
  circleId   String
  circle     Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())

  @@unique([circleId, userId])
  @@index([userId])
}

// One shared thing. `kind` is "value" or "decision". All text is ciphertext.
model Share {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  circleId   String?
  circle     Circle?   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  kind       String
  // Snapshot of the source at share time.
  title      String?
  body       String?
  occurredAt DateTime?
  // For a shared position: the whole why-chain as it stood at share time,
  // encrypted like everything else. A snapshot rather than a reference,
  // consistent with the rest of sharing — someone shown your argument should
  // keep seeing the argument they were shown, not silently get a later one.
  //
  // Stored as JSON so an argument travels as one object. Nodes carry their
  // parent's index rather than a database id: the recipient has no business
  // holding row ids from your journal, and the shape is all they need.
  chain      String?
  // What you wrote for this audience specifically — not a private reflection.
  note       String?
  // Per-share choices. A value's definition is what makes disagreement
  // legible ("I read modesty this way, you read it that way"), so it's
  // included by default — but it is still the sharer's call.
  showBody   Boolean   @default(true)
  showNote   Boolean   @default(true)
  // A shared position can be just the claim, or the claim with the reasoning
  // under it, or that plus the axioms it bottoms out in. Naming your bedrock
  // is the most exposing thing this app can do, so it's a separate choice from
  // showing the argument.
  showChain  Boolean   @default(true)
  showAxioms Boolean   @default(true)
  // Hidden hides it from everyone without destroying it; you can unhide.
  hiddenAt   DateTime?
  createdAt  DateTime  @default(now())

  comments ShareComment[]
  links    ShareLink[]

  @@index([circleId])
  @@index([userId])
}

model ShareComment {
  id        String    @id @default(cuid())
  shareId   String
  share     Share     @relation(fields: [shareId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([shareId])
}

// A one-off link to a single share, for showing someone your reasoning without
// pulling them into a circle. View-only, revocable, optionally expiring.
model ShareLink {
  id          String    @id @default(cuid())
  shareId     String
  share       Share     @relation(fields: [shareId], references: [id], onDelete: Cascade)
  // Hashed for lookup, encrypted for re-display. See CircleInvite.
  tokenHash   String    @unique
  tokenEnc    String
  createdById String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([shareId])
}

// A "what should I do?" decision-aid query and its response. The tool lays out
// how the user's stated values bear on the situation — options and tensions,
// never a verdict. `question` and `body` are ciphertext.
model Consultation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  body      String
  model     String
  createdAt DateTime @default(now())

  @@index([userId])
}

// A stored AI reflection over the user's values + decisions. `body` is ciphertext.
//
// `scope` records what the reflection actually looked at ("Everything",
// "The last 90 days", or a specific value's title). It is ciphertext like
// everything else — a scope naming a value would otherwise leak that value's
// wording in plaintext.
// `source` is "self" for a reflection the person wrote themselves and "ai" for
// a generated one. Self-written reflections are the primary case: this tool
// works fully without a model, and someone thinking on their own should get
// the same first-class surface as someone using inference. `model` is the
// model id for AI entries and "you" for self-written ones.
model Reflection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  model     String
  source    String   @default("ai")
  scope     String   @default("Everything")
  createdAt DateTime @default(now())

  @@index([userId])
}
