# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Database ---
# Dev default: local SQLite file (zero setup).
DATABASE_URL="file:./dev.db"
# To use Postgres instead, set provider="postgresql" in prisma/schema.prisma and use e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/groundwork?schema=public"

# --- Session signing secret (JWT) ---
# Generate with:  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string"

# --- Field encryption key (AES-256-GCM) ---
# Must be 64 hex characters (32 bytes). Generate with:  openssl rand -hex 32
# If you rotate this, previously stored data can no longer be decrypted — back it up.
APP_ENCRYPTION_KEY="replace-me-with-64-hex-chars"

# --- AI: entirely optional ---
# The app is complete without it. Values, decisions, the timeline, patterns,
# and reflections you write yourself all work with no key, no cost, and
# nothing transmitted anywhere. Set "false" to remove the AI features
# outright; unset, it follows whether a key is configured.
AI_ENABLED="true"

# --- Anthropic (Claude) API — only needed if AI_ENABLED is on ---
# Get one at https://console.anthropic.com/. The app pays for inference, not the user.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: override the model used for reflections. Defaults to claude-opus-5.
# A cheaper model (e.g. claude-sonnet-5) materially reduces per-request cost if
# the reflections are good enough for you at that tier — try it and compare.
# ANTHROPIC_MODEL="claude-opus-5"

# --- AI cost guard ---
# Per-user caps shared across the Reflect and Ask features. The app pays for
# inference, so these keep a runaway loop from becoming a surprise bill.
# Rough cost: ~$0.10 per request on Claude Opus 5 with thinking on, so 40/day
# worst case is ~$120/month — inside the build plan's $50-150 budget.
AI_LIMIT_PER_HOUR="15"
AI_LIMIT_PER_DAY="40"

# --- Email (password reset delivery) ---
# No provider is wired up. In development the reset link is printed to the
# server log, which is enough to complete a reset locally. In production,
# sending fails loudly rather than logging a working credential to stdout —
# add a provider in src/lib/mail.ts (one function) before real users exist.

# --- Sign-in brute-force throttle ---
LOGIN_MAX_ATTEMPTS="10"
LOGIN_WINDOW_MINUTES="15"

# --- Dev convenience ---
# When "true" AND not in production, skips the login screen and auto-logs-in a
# local "dev@local" user (seeded with sample data) so you don't sign in each
# time. Hard-gated off in production. Leave unset/empty for normal auth.
DEV_AUTOLOGIN="true"
